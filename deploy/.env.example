# Copy to deploy/.env (never commit the real file) and change the password.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Port on this machine where the game is served (http://localhost:8080).
HTTP_PORT=8080

# Seq log viewer, only reachable from this machine (http://localhost:5341).
SEQ_UI_PORT=5341

# Later, on a real server: set the domain name here to get automatic HTTPS from Caddy.
# SITE_ADDRESS=xidach.example.com
